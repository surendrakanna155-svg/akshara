# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.g.dart

# IDE
.idea/
.vscode/
*.iml
*.swp

# OS
.DS_Store
Thumbs.db

# Secrets
.env
.env.*
*.pem
credentials.json

# Android release signing (never commit the keystore or its passwords)
android/key.properties
*.keystore
*.jks

# Supabase CLI local state
supabase/.temp/

# Python
__pycache__/
*.pyc

# QA runtime artifacts (keep folder structure)
qa/screenshots/**/*
!qa/screenshots/.gitkeep
qa/reports/**/*
!qa/reports/.gitkeep
qa/patrol/screenshots/**/*
!qa/patrol/screenshots/.gitkeep
qa/patrol/reports/**/*
!qa/patrol/reports/.gitkeep
!qa/patrol/reports/bugs.json

# Patrol generated bundle
patrol_test/test_bundle.dart

# Coverage
coverage/
lcov.info

# Flutter golden-test failure diffs (transient — regenerated each run, never commit)
test/**/failures/

# Stray flutter run logs
flutter_*.log

# Local tool / CLI state (never commit) — except versioned project skills & commands
.claude/*
!.claude/skills/
!.claude/commands/
supabase/.branches/

# Firebase service-account secrets — never commit
*firebase-adminsdk*.json
FCM_SERVICE_ACCOUNT*.json

# Curriculum downloaded resources — LOCAL ONLY (see curriculum/.gitignore + policy)
curriculum/resources/
curriculum/downloads/
curriculum/cache/
curriculum/archives/
curriculum/acquisition/*.log

# Node dependency trees (any depth) — never commit
node_modules/

# Local deploy virtualenv — never commit (relies on the venv's own self-ignore otherwise)
.venv-deploy/

# Local SQLite knowledge/question databases (kie.db, qie.db, …) — LOCAL ONLY.
# The frozen KIE foundation + QIE dbs are backed up off-repo (owner-approved
# location); they are derived data, never committed. See curriculum local-storage lock.
*.db
# SQLite WAL/SHM sidecars — transient, never commit (remediation R0-4).
*.db-wal
*.db-shm

# Local progress-dashboard dev tool — LOCAL ONLY on this implementation branch (owner
# decision 2026-07-08: keep local, do NOT commit here; it gets its own dedicated branch
# and merges later). A subagent committed it off-brief (6244b3e0/6949fe3d) + relaxed this
# ignore; restored to a full-dir ignore so nothing dashboard-related is tracked here.
tools/progress-dashboard/

# Generated golden-failure diff output (masterImage/testImage/isolatedDiff/maskedDiff) — never commit
test/golden/failures/
