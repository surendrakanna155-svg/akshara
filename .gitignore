# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.g.dart

# IDE
.idea/
.vscode/
*.iml
*.swp

# OS
.DS_Store
Thumbs.db

# Secrets
.env
.env.*
*.pem
credentials.json

# Android release signing (never commit the keystore or its passwords)
android/key.properties
*.keystore
*.jks

# Supabase CLI local state
supabase/.temp/

# Python
__pycache__/
*.pyc

# QA runtime artifacts (keep folder structure)
qa/screenshots/**/*
!qa/screenshots/.gitkeep
qa/reports/**/*
!qa/reports/.gitkeep
qa/patrol/screenshots/**/*
!qa/patrol/screenshots/.gitkeep
qa/patrol/reports/**/*
!qa/patrol/reports/.gitkeep
!qa/patrol/reports/bugs.json

# Patrol generated bundle
patrol_test/test_bundle.dart

# Coverage
coverage/
lcov.info

# Flutter golden-test failure diffs (transient — regenerated each run, never commit)
test/**/failures/

# Stray flutter run logs
flutter_*.log

# Local tool / CLI state (never commit) — except versioned project skills & commands
.claude/*
!.claude/skills/
!.claude/commands/
supabase/.branches/

# Firebase service-account secrets — never commit
*firebase-adminsdk*.json
FCM_SERVICE_ACCOUNT*.json

# Progress-dashboard runtime state — live files stay LOCAL (updated continuously by the
# executor, so they never create Git noise). The committed *.seed.json are the fresh-clone
# starting snapshot; app.js reads the live file and falls back to the seed when it's absent.
# See tools/progress-dashboard/README.md ("Git tracking").
tools/progress-dashboard/progress.json
tools/progress-dashboard/activity.json
