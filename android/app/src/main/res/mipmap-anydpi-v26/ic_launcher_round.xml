<?xml version="1.0" encoding="utf-8"?>
<!-- PLY-4: round launcher variant. On API 26+ the same adaptive layers are
     masked to the launcher's shape (incl. round), so it reuses ic_launcher's
     background/foreground. Pre-26 devices fall back to android:icon. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground>
      <inset
          android:drawable="@drawable/ic_launcher_foreground"
          android:inset="16%" />
  </foreground>
</adaptive-icon>
