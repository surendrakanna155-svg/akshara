# Akshara ERP — Backend environment template (staging / local)
# Copy to .env.local for `supabase functions serve` — never commit secrets.

APP_ENV=staging
AUTH_OTP_DEV_MODE=true

# Required — generate with: openssl rand -base64 48
JWT_SECRET=

# Supabase (local `supabase start` prints these; staging uses CI secrets)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional tuning
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3

# SMS provider (production only — not required when AUTH_OTP_DEV_MODE=true)
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# Flutter client staging override (dart-define, not used by Edge Functions)
# API_BASE_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/api
