# Curriculum workspace — binary/content trees NEVER enter git (R10 guard).
# Committed: configs/, scripts/, reports/ (markdown), indexes/ + metadata/ summaries, PM files.
resources/
downloads/
cache/
temp/
archives/
*.pdf
*.docx
*.doc
*.epub
*.zip
# Runtime engineering logs are seeded on disk (Part-04 logs/) but are
# machine-local artifacts — keep them out of git; the tracked logs/.gitkeep
# preserves the directory.
logs/*.log
__pycache__/
*.pyc
