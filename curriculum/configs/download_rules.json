{
  "_comment": "Download-lane behaviour (spec Parts 02/03/05). Config-driven: the downloader reads order/policy/networking from here, never from hard-coded logic. LEGAL (Risk R1): default_mode='dry_run' and allow_network=false — the acquisition tooling is scaffolding + a local dry-run in this environment; a networked run flips allow_network=true and mode='live' explicitly, and still only fetches from legal official/open sources. Never bypass auth or paywalls.",
  "default_mode": "dry_run",
  "allow_network": false,
  "allowed_url_schemes": ["file", "https"],
  "networking": {
    "_comment": "Only used when allow_network=true. Values mirror retry_rules.json so the two lanes stay consistent.",
    "user_agent": "AksharaCurriculumBot/1.0 (+education-repository; contact: akshara-erp)",
    "connect_timeout_seconds": 30,
    "read_timeout_seconds": 120,
    "max_redirects": 5,
    "polite_delay_seconds": 2,
    "respect_robots_txt": true,
    "chunk_bytes": 1048576
  },
  "source_priority_ladder": [
    "official_government_educational_website",
    "official_educational_board",
    "official_government_digital_library",
    "official_publisher_resource",
    "official_open_educational_platform",
    "trusted_educational_repository",
    "public_archive_source_if_legally_permitted"
  ],
  "board_order_source": "boards.json:board_order",
  "class_order_source": "classes.json:class_order",
  "within_subject_download_order": [
    "syllabus",
    "textbook",
    "teacher_guide",
    "academic_standards",
    "learning_outcomes",
    "blueprint",
    "question_bank",
    "sample_paper",
    "previous_paper",
    "worksheet",
    "activity_book",
    "lab_manual",
    "reference",
    "circular",
    "notification",
    "supplementary"
  ],
  "document_type_to_category": {
    "Curriculum": "syllabus",
    "Syllabus": "syllabus",
    "Textbook": "textbook",
    "Workbook": "worksheet",
    "Teacher Guide": "teacher_guide",
    "Teacher Handbook": "teacher_guide",
    "Learning Outcomes": "learning_outcomes",
    "Academic Standards": "academic_standards",
    "Blueprint": "blueprint",
    "Assessment Framework": "blueprint",
    "Assessment Guidelines": "blueprint",
    "Competency Framework": "blueprint",
    "Question Bank": "question_bank",
    "Sample Paper": "sample_paper",
    "Model Paper": "sample_paper",
    "Marking Scheme": "sample_paper",
    "Previous Paper": "previous_paper",
    "Worksheet": "worksheet",
    "Activity Book": "activity_book",
    "Lab Manual": "lab_manual",
    "Practical Manual": "lab_manual",
    "Reference Material": "reference",
    "Circular": "circular",
    "Notification": "notification",
    "Supplementary Resource": "supplementary",
    "Foundation Material": "supplementary"
  },
  "category_to_subject_folder": {
    "syllabus": "Syllabus",
    "textbook": "Textbooks",
    "teacher_guide": "Teacher_Guides",
    "learning_outcomes": "Learning_Outcomes",
    "academic_standards": "Academic_Standards",
    "blueprint": "Blueprints",
    "question_bank": "Question_Banks",
    "sample_paper": "Sample_Papers",
    "previous_paper": "Previous_Papers",
    "worksheet": "Worksheets",
    "activity_book": "Activity_Books",
    "lab_manual": "Lab_Manuals",
    "assessment": "Assessment",
    "reference": "Reference",
    "circular": "Circulars",
    "notification": "Notifications",
    "supplementary": "Reference"
  },
  "duplicate_policy": {
    "compare": ["filename", "sha256", "version", "source"],
    "keep": "highest_quality_verified_copy",
    "document_removals": true
  }
}
