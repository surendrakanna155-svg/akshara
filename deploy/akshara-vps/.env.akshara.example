# Copy to .env.akshara on the VPS (chmod 600). Never commit real secrets.
POSTGRES_DB=akshara_db
POSTGRES_PASSWORD=__openssl_rand__
JWT_SECRET=__app_jwt_min32__
APP_ENV=staging

# --- OTP login & SMS (Batch 2: real, safe login) ---
# Global dev mode: when true AND APP_ENV != production, OTP is returned in the
# login response for ALL phones. Keep false; use the pilot allowlist for testers.
AUTH_OTP_DEV_MODE=false
# Comma/space separated phones (E.164) that get the OTP in the response (no SMS).
# Owner + testers only.
AUTH_OTP_PILOT_PHONES=+919550055155
# Rate limiting (sliding window). Defaults shown.
OTP_RATE_WINDOW_SECONDS=3600
OTP_MAX_REQUESTS_PER_PHONE=5
OTP_MAX_REQUESTS_PER_IP=20
OTP_RESEND_COOLDOWN_SECONDS=60
# SMS provider. Real key goes in .env.akshara only (chmod 600), never in git.
SMS_PROVIDER=fast2sms
SMS_PROVIDER_API_KEY=__fast2sms_api_key__
# Fast2SMS route: "q" (quick, works without DLT/verification — pilot default),
# "otp" (needs Fast2SMS website verification), "dlt" (needs sender id + template).
FAST2SMS_ROUTE=q
# FAST2SMS_SENDER_ID=__dlt_sender_id__
# FAST2SMS_MESSAGE_ID=__dlt_template_id__

SUPABASE_URL=http://akshara-rest-gateway:8080
SUPABASE_SERVICE_ROLE_KEY=__HS256_jwt_role=service_role_signed_with_PGRST_JWT_SECRET__
SUPABASE_ANON_KEY=__HS256_jwt_role=anon_signed_with_PGRST_JWT_SECRET__
ERP_TENANT_DATABASE_URL=postgresql://erp_tenant:__ERP_PW__@akshara-postgres:5432/akshara_db
PORT=8000

# --- Storage (Batch 7) ---
# Public origin a DEVICE can reach storage at. The edge generates signed upload/
# download URLs against the internal gateway, then rewrites the origin to this
# before returning them to the app (the phone can't reach the internal host).
# Must match the storage route on the public Nginx vhost (see storage/README.md).
PUBLIC_STORAGE_BASE_URL=https://akshara.veloraunisexsalon.com

# --- Backups (Batch 7) ---
# Max age (hours) of the latest successful DB backup before /health/backup is 503.
BACKUP_MAX_AGE_HOURS=26

# --- AI / Claude (Batch 8) ---
# Anthropic API key enables LIVE AI (copilot + parent insights). Real key goes
# in .env.akshara only (chmod 600), never in git. With no key the copilot serves
# its read-only stub and parent insights stay deterministic — both safe.
ANTHROPIC_API_KEY=__anthropic_api_key__
# Optional model override (defaults to claude-opus-4-8). Set to claude-sonnet-4-6
# or claude-haiku-4-5 to trade some quality for lower cost on high-volume chat.
# ANTHROPIC_MODEL=claude-opus-4-8
