# Akshara backup config — copy to /opt/akshara/backup/backup.env on the VPS (chmod 600).
# Never commit the real file. All paths are on the VPS host.

# --- Database (matches docker-compose.akshara.yml) ---
AKSHARA_PG_CONTAINER=akshara-postgres
AKSHARA_DB_NAME=akshara_db
AKSHARA_DB_USER=supabase_admin

# --- Local backup storage ---
BACKUP_ROOT=/opt/akshara/backup/store
LOG_DIR=/var/log/akshara

# --- Encryption ---
# Backups are AES-256 encrypted before they ever leave pg_dump. The passphrase
# lives in this file (chmod 600); install-ops-cron.sh generates one if missing.
# WITHOUT this key a leaked backup file is useless — and unrecoverable. Keep a
# copy of the key somewhere safe and OFF this box (e.g. a password manager).
BACKUP_KEY_FILE=/opt/akshara/backup/secret.key

# --- Retention (grandfather-father-son) ---
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=12

# --- Off-site copy (the "1" in 3-2-1: a copy OFF this server) ---
# Leave RCLONE_REMOTE empty to run local-only (a loud warning is logged and the
# backup is recorded with offsite=false). This is the SAFE default — nothing
# below activates until RCLONE_REMOTE is set. To enable, follow the runbook:
#   docs/engineering/eos/OFFSITE_BACKUP_R2_RUNBOOK.md
# ...short version: install rclone, copy rclone.conf.example -> rclone.conf and
# fill in real Cloudflare R2 (or any S3-compatible) values, then set both vars
# below. Example: RCLONE_REMOTE=r2:akshara-backups/db
RCLONE_REMOTE=
# Path to the rclone config holding the remote's credentials (see
# rclone.conf.example in this directory). Leave empty to use rclone's own
# default config location instead (~/.config/rclone/rclone.conf for the user
# running the backup, i.e. root).
RCLONE_CONFIG_FILE=
# Extra flags passed to rclone (optional).
RCLONE_FLAGS=--s3-no-check-bucket

# --- Restore-drill target (throwaway db name; dropped/recreated each drill) ---
DRILL_DB=akshara_db_drill
