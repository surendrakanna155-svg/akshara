# Akshara scheduled-broadcast cron config — copy to
# /opt/akshara/communication-cron/communication-cron.env (chmod 600, root-only).
# Never commit the real file — this example carries NO secret value.

# Base URL the VPS reaches the akshara-edge (api) container at.
EDGE_BASE=http://127.0.0.1:3000

# COM-4: shared secret the cron presents via `x-internal-cron-token`. MUST
# match the akshara-edge container's INTERNAL_CRON_TOKEN env var exactly, or
# every run gets 401 (server-side unset/mismatch always fails closed — see
# supabase/functions/_shared/communication/communication_cron_auth.ts).
# Generate with:  openssl rand -base64 48
INTERNAL_CRON_TOKEN=

LOG_DIR=/var/log/akshara
