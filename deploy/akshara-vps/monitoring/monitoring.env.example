# Akshara watchdog config — copy to /opt/akshara/monitoring/monitoring.env (chmod 600).
# Never commit the real file.

EDGE_BASE=http://127.0.0.1:3000
PUBLIC_DOMAIN=api.nikshaos.in
CERT_PATH=/etc/letsencrypt/live/api.nikshaos.in/fullchain.pem

# Thresholds
DISK_WARN_PCT=85
CERT_WARN_DAYS=14

# Containers that must be running (postgres also health-checked).
CONTAINERS="akshara-postgres akshara-postgrest akshara-rest-gateway akshara-edge akshara-storage"

# Token for guarded health endpoints (/health/backup,/storage). Leave empty in
# staging (endpoints open); REQUIRED once APP_ENV=production.
INTERNAL_HEALTH_TOKEN=

# --- Alert sinks (all optional; the watchdog always logs) ---
# Generic webhook (Slack/Telegram/n8n/etc): receives a JSON {host,severity,text}.
ALERT_WEBHOOK_URL=
# SMS to owner/ops via Fast2SMS for CRITICAL alerts. Comma-separated E.164 (digits).
ALERT_SMS_PHONES=
# Fast2SMS key; if empty the watchdog falls back to SMS_PROVIDER_API_KEY in .env.akshara.
ALERT_SMS_API_KEY=
FAST2SMS_ROUTE=q

# Minutes to suppress a repeat alert for the SAME failing check (anti-spam).
ALERT_COOLDOWN_MIN=60

STATE_DIR=/opt/akshara/monitoring/state
LOG_DIR=/var/log/akshara
APP_ENV_FILE=/opt/akshara/.env.akshara
