# Akshara storage-api env — copy to /opt/akshara/storage.env on the VPS (chmod 600).
# Never commit real secrets. Image: supabase/storage-api:v1.19.3
#
# ANON_KEY / SERVICE_KEY  = the same HS256 JWTs used by PostgREST (from .env.akshara)
# PGRST_JWT_SECRET        = same secret as postgrest.env (validates the JWTs)
# DATABASE_URL            = supabase_storage_admin role (set its password once; see README)

ANON_KEY=__SUPABASE_ANON_KEY__
SERVICE_KEY=__SUPABASE_SERVICE_ROLE_KEY__
PGRST_JWT_SECRET=__PGRST_JWT_SECRET__
AUTH_JWT_SECRET=__PGRST_JWT_SECRET__
DATABASE_URL=postgres://supabase_storage_admin:__STORAGE_DB_PW__@akshara-postgres:5432/akshara_db
POSTGREST_URL=http://akshara-postgrest:3000
PGOPTIONS=-c search_path=storage,public
FILE_SIZE_LIMIT=52428800
STORAGE_BACKEND=file
FILE_STORAGE_BACKEND_PATH=/var/lib/storage
TENANT_ID=akshara
REGION=local
GLOBAL_S3_BUCKET=akshara
ENABLE_IMAGE_TRANSFORMATION=false
# Roles already exist on this DB (supabase image) -> skip storage-api's role
# install; we apply grants ourselves via storage_grants_bucket_policies.sql.
DB_INSTALL_ROLES=false
