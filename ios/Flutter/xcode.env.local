# Ensures xcrun and native-asset hooks resolve iOS SDKs when hooks_runner
# filters DEVELOPER_DIR from the hook subprocess environment.
export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
# SRCROOT is set by Xcode to the ios/ folder; fallback for manual sourcing.
_IOS_ROOT="${SRCROOT:-${PWD}/ios}"
export PATH="$(cd "${_IOS_ROOT}/.." && pwd)/scripts/ios:${PATH}"
