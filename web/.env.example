# Akshara Web Platform — environment
# Copy to `.env` and set for a live backend. Defaults keep the app in "awaiting
# backend" state (no fabricated data) until these are provided.

# Data mode: "demo" = backend not wired, render Loading/Empty/Error/Awaiting states
#            + role-preview sign-in.
#            "live" = call the real REST edge function below + phone/OTP sign-in.
VITE_DATA_MODE=demo

# Base URL of the Akshara REST edge function.
# Production VPS (verified reachable): https://akshara.veloraunisexsalon.com/functions/v1/api
# Local dev:                           http://localhost:8080/v1
VITE_API_BASE_URL=https://akshara.veloraunisexsalon.com/functions/v1/api

# --- To run against the live pilot backend ---
#   VITE_DATA_MODE=live
#   VITE_API_BASE_URL=https://akshara.veloraunisexsalon.com/functions/v1/api
# Then sign in with a pilot phone (OTP is returned in-app on the pilot/dev backend).
