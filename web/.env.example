# Akshara Web Platform — environment
# Copy to `.env` and set for a live backend. Defaults keep the app in "awaiting
# backend" state (no fabricated data) until these are provided.

# Data mode: "demo" = backend not wired, render Loading/Empty/Error/Awaiting states.
#            "live" = call the real REST edge function below.
VITE_DATA_MODE=demo

# Auth mode: OPTIONAL. Defaults to VITE_DATA_MODE.
#   "demo" = the "Explore by role" tab + persona switcher exist; a preview
#            identity can be created client-side with no backend token.
#   "live" = phone -> OTP -> real bearer token is the ONLY way in. Every
#            preview-identity path is hard-disabled in code, not merely hidden.
# Fail-closed: anything other than the literal "demo" resolves to live auth.
# VITE_AUTH_MODE=live

# Base URL of the Akshara REST edge function.
# Production VPS (verified reachable): https://api.nikshaos.in/functions/v1/api
# Local dev:                           http://localhost:8080/v1
VITE_API_BASE_URL=https://api.nikshaos.in/functions/v1/api

# --- Production build (app.nikshaos.in) ---
#   npm run build:prod
#   => VITE_DATA_MODE=live; auth mode defaults to live.
#   Login is: mobile number -> send verification code -> OTP. Nothing else.
#
# --- Demo build (future demo.nikshaos.in) ---
#   npm run build:demo                          # demo data + demo auth
#   VITE_DATA_MODE=live VITE_AUTH_MODE=demo npm run build
#                                               # live demo-school backend + role explorer
#   The demo experience is preserved in full — the whole demo school, every demo
#   user, all demo navigation, every preview capability. Production and demo are
#   separated by BUILD, not by branch: one codebase, two artifacts.
